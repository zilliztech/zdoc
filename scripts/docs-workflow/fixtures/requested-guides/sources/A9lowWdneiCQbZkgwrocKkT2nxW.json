                  "bold": false,
                  "inline_code": true,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": " is the <include target=\"milvus\">Milvus</include><include target=\"zilliz\">Zilliz Cloud</include> field name and ",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
                  "underline": false
                }
              }
            },
            {
              "text_run": {
                "content": "external_field=\"score\"",
                "text_element_style": {
                  "bold": false,
