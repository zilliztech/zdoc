              "text_run": {
                "content": "index_params = client.prepare_index_params()\n\nindex_params.add_index(\n    field_name=\"image_embedding_v2\",\n    index_type=\"AUTOINDEX\",\n    metric_type=\"COSINE\",\n)\n\nclient.create_index(\n    collection_name=\"product_embeddings\",\n    index_params=index_params,\n",
