        "block_id": "doxcn2dnu7vvjGgQASu1ZV8WMsb",
        "block_type": 14,
        "code": {
          "elements": [
            {
              "text_run": {
                "content": "from pymilvus import DataType, MilvusClient\n\nclient = MilvusClient(\n    uri=\"http://localhost:19530\",\n    token=\"root:Milvus\",\n)\n\nclient.add_collection_field(\n    collection_name=\"product_embeddings\",\n    field_name=\"image_embedding_v2\",\n    data_type=DataType.FLOAT_VECTOR,\n    dim=768,\n    nullable=True,\n    # highlight-next-line\n    external_field=\"image_embedding_v2\",\n",
                "text_element_style": {
                  "bold": false,
                  "inline_code": false,
                  "italic": false,
                  "strikethrough": false,
