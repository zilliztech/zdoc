        "scripts/docs-workflow/translation-publication-adapter*",
        "scripts/docs-workflow/tooling-publication-adapter*"
      ],
      "focusedTests": [
        "node --test scripts/docs-workflow/publication-contracts.test.js scripts/docs-workflow/publication-workflow-adapters.test.js scripts/docs-workflow/fetch-publication-adapter.test.js scripts/docs-workflow/translation-publication-adapter.test.js scripts/docs-workflow/tooling-publication-adapter.test.js"
      ],
      "harnesses": ["pnpm test:replay:all"],
      "gates": ["pnpm test:workflow-policy"],
      "reason": "Shared schemas and adapters affect Fetch, Translation, progress/results authentication, and recovery."
