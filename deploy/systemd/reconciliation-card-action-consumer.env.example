# GitHub token for zilliztech/zdoc. The durable-pr path needs contents:write and
# pull_requests:write in addition to actions:read.
GITHUB_TOKEN=

# lark-cli bot identity is configured separately:
#   lark-cli config init
#   lark-cli auth login --domain all

# Optional card-update subprocess timeout in milliseconds.
LARK_CARD_UPDATE_TIMEOUT_MS=30000
