{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.zilliz.com/contracts/release.schema.json",
  "title": "Zilliz documentation release record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "site",
    "environment",
    "mode",
    "sourceRepository",
    "sourceSha",
    "finalDeployedDigest",
    "jenkinsBuildIdentity"
  ],
  "properties": {
    "site": {"enum": ["en", "zh-CN"]},
    "environment": {"enum": ["uat", "prod"]},
    "mode": {"enum": ["rebuild", "specified-image"]},
    "sourceRepository": {"const": "zdoc"},
    "sourceSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "operatorImageRef": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/:@-]*$"},
    "sourceUatDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "finalDeployedDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "jenkinsBuildIdentity": {"type": "string", "pattern": "^vdc-jenkins/(english|chinese)-(uat|prod)/[1-9][0-9]*$"},
    "status": {"enum": ["succeeded", "failed", "pending"]}
  },
  "oneOf": [
    {
      "properties": {
        "environment": {"const": "uat"},
        "mode": {"const": "rebuild"},
        "operatorImageRef": false,
        "sourceUatDigest": false,
        "status": {"enum": ["succeeded", "failed", "pending"]}
      },
      "required": ["environment", "mode", "status"]
    },
    {
      "properties": {
        "environment": {"const": "prod"},
        "mode": {"const": "rebuild"},
        "operatorImageRef": false,
        "sourceUatDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "required": ["environment", "mode", "sourceUatDigest"]
    },
    {
      "properties": {
        "environment": {"const": "prod"},
        "mode": {"const": "specified-image"},
        "operatorImageRef": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/:@-]*$"},
        "sourceUatDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "required": ["environment", "mode", "operatorImageRef", "sourceUatDigest"]
    }
  ],
  "allOf": [
    {
      "if": {"properties": {"site": {"const": "en"}}, "required": ["site"]},
      "then": {"properties": {"jenkinsBuildIdentity": {"type": "string", "pattern": "^vdc-jenkins/english-(uat|prod)/[1-9][0-9]*$"}}}
    },
    {
      "if": {"properties": {"site": {"const": "zh-CN"}}, "required": ["site"]},
      "then": {"properties": {"jenkinsBuildIdentity": {"type": "string", "pattern": "^vdc-jenkins/chinese-(uat|prod)/[1-9][0-9]*$"}}}
    },
    {
      "if": {"properties": {"environment": {"const": "uat"}}, "required": ["environment"]},
      "then": {"properties": {"jenkinsBuildIdentity": {"type": "string", "pattern": "^vdc-jenkins/(english|chinese)-uat/[1-9][0-9]*$"}}}
    },
    {
      "if": {"properties": {"environment": {"const": "prod"}}, "required": ["environment"]},
      "then": {"properties": {"jenkinsBuildIdentity": {"type": "string", "pattern": "^vdc-jenkins/(english|chinese)-prod/[1-9][0-9]*$"}}}
    }
  ]
}
