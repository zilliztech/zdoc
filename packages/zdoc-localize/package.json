{
  "name": "zdoc-localize",
  "version": "0.1.0",
  "description": "Stale-safe localization planning and Feishu block updates for ZDoc.",
  "type": "module",
  "bin": {
    "zdoc-localize": "dist/cli/index.js"
  },
  "main": "dist/cli/index.js",
  "types": "dist/cli/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:package": "node scripts/package-smoke.mjs",
    "pack:check": "pnpm run build && pnpm pack"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "saxes": "^6.0.0",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "~5.6.2",
    "vitest": "^4.1.0"
  }
}
