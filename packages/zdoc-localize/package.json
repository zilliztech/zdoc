{
  "name": "zdoc-localize",
  "version": "0.2.0",
  "description": "Stale-safe localization planning and Feishu block updates for ZDoc.",
  "type": "module",
  "bin": {
    "zdoc-localize": "dist/cli/index.js"
  },
  "main": "dist/cli/index.js",
  "types": "dist/cli/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:package": "node scripts/package-smoke.mjs",
    "pack:check": "node scripts/package-artifact-guard.mjs",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "feishu-docx-engine": "0.2.1",
    "saxes": "^6.0.0",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "typescript": "~5.6.2",
    "vitest": "^3.2.4"
  }
}
