                  "token": "shared-other",
                  "outputPath": "fixtures/en/guides/alphanumonly-filter.mdx",
                  "origin": "upstream",
                  "current": true,
                  "next": true
                }
              ]
            }
          ]
        }
      ],
      "expectedErrors": [
