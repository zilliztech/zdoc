    "/v2/vectordb/jobs/snapshot/export": {
      "post": {
        "operationId": "exportSnapshot",
        "summary": "Export Snapshot",
        "deprecated": false,
        "description": "Exports a collection snapshot to the configured object storage.",
        "x-i18n": {
          "zh-CN": {
            "summary": "导出快照",
            "description": "将 Collection 快照导出到已配置的对象存储。"
          }
        },
        "tags": [
          "Snapshot Operations (V2)"
        ],
        "x-base-urls": {
          "$ref": "#/components/x-base-urls/ZillizVectorV2"
        },
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "description": "The authentication token should be an API key with appropriate privileges.",
            "required": false,
            "example": "Bearer {{TOKEN}}",
            "schema": {
              "type": "string",
              "x-added-at": "3.0.x",
              "x-last-modified": "3.0.x",
              "x-deprecated-since": null
            },
            "x-i18n": {
              "zh-CN": {
                "description": "认证令牌，应为具备适当权限的 API 密钥。"
              }
            },
            "x-added-at": "3.0.x",
            "x-last-modified": "3.0.x",
            "x-deprecated-since": null
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "dbName": {
                    "type": "string",
                    "description": "The name of the database that contains the collection.",
                    "x-i18n": {
                      "zh-CN": {
                        "description": "Collection 所属数据库名称。"
                      }
                    },
                    "x-added-at": "3.0.x",
                    "x-last-modified": "3.0.x",
                    "x-deprecated-since": null
                  },
                  "collectionName": {
                    "type": "string",
                    "description": "The name of the collection to snapshot.",
                    "x-i18n": {
                      "zh-CN": {
                        "description": "要创建快照的 Collection 名称。"
                      }
                    },
                    "x-added-at": "3.0.x",
                    "x-last-modified": "3.0.x",
                    "x-deprecated-since": null
                  },
                  "snapshotName": {
                    "type": "string",
                    "description": "The name of the snapshot.",
                    "x-i18n": {
                      "zh-CN": {
                        "description": "快照名称。"
                      }
                    },
                    "x-added-at": "3.0.x",
                    "x-last-modified": "3.0.x",
                    "x-deprecated-since": null
                  },
                  "targetS3Path": {
                    "type": "string",
                    "description": "The root path in S3-compatible object storage under which Milvus writes the exported snapshot data and metadata. It must be a writable URI such as `s3://bucket-name/export-root`. Milvus appends snapshot-specific metadata paths below this root; the response returns the generated `snapshotMetadataURI`.",
                    "x-i18n": {
                      "zh-CN": {
                        "description": "Milvus 写入导出快照数据和元数据的 S3 兼容对象存储根路径。该值应为可写的 URI，例如 `s3://bucket-name/export-root`。Milvus 会在此根路径下追加快照专属的元数据路径；响应中返回生成的 `snapshotMetadataURI`。"
                      }
                    },
                    "x-added-at": "3.0.x",
                    "x-last-modified": "3.0.x",
                    "x-deprecated-since": null
                  },
                  "externalSpec": {
                    "type": "string",
                    "description": "Optional JSON configuration for external object storage. When `targetS3Path` points to storage outside the Milvus-managed bucket, pass an `extfs` object to override how Milvus accesses that bucket. Supported JSON fields:\n\n- `format`: `\"parquet\"`, `\"lance-table\"`, or `\"vortex\"`; defaults to `\"parquet\"` when omitted or when the whole value is empty.\n- `columns`: optional array of column names to load.\n- `extfs`: optional map of object-storage overrides. Allowed keys are `cloud_provider`, `region`, `use_iam`, `use_ssl`, `use_virtual_host`, `iam_endpoint`, `storage_type`, `ssl_ca_cert`, `access_key_id`, and `access_key_value`.\n\nRequirements:\n\n- The value must be valid JSON.\n- `format` must be one of the supported values above.\n- `extfs` keys are allowlisted; unsupported keys are rejected.\n- `use_iam`, `use_ssl`, and `use_virtual_host` must be the strings `\"true\"` or `\"false\"`.\n- Use `extfs` only when the target bucket requires credentials or connectivity settings different from the Milvus-managed bucket. Omit `externalSpec` or pass an empty string to use the default Milvus-managed storage.\n\nExample: `{\"format\":\"parquet\",\"extfs\":{\"cloud_provider\":\"aws\",\"region\":\"us-west-2\",\"use_iam\":\"true\"}}`.",
                    "x-i18n": {
                      "zh-CN": {
                        "description": "可选的外部对象存储配置 JSON。当 `targetS3Path` 指向 Milvus 管理 bucket 之外的存储时，可传入 `extfs` 对象以覆盖 Milvus 访问该 bucket 的方式。支持的 JSON 字段：\n\n- `format`：`\"parquet\"`、`\"lance-table\"` 或 `\"vortex\"`；省略或整个值为空时默认为 `\"parquet\"`。\n- `columns`：可选的要加载的列名数组。\n- `extfs`：可选的对象存储覆盖配置。允许的键包括 `cloud_provider`、`region`、`use_iam`、`use_ssl`、`use_virtual_host`、`iam_endpoint`、`storage_type`、`ssl_ca_cert`、`access_key_id` 和 `access_key_value`。\n\n要求：\n\n- 值必须是合法 JSON。\n- `format` 必须是上述支持值之一。\n- `extfs` 的键必须位于允许列表中，不支持的键会被拒绝。\n- `use_iam`、`use_ssl`、`use_virtual_host` 必须是字符串 `\"true\"` 或 `\"false\"`。\n- 仅当目标 bucket 需要与 Milvus 管理 bucket 不同的凭据或连接设置时才使用 `extfs`。如需使用默认的 Milvus 管理存储，请省略 `externalSpec` 或传入空字符串。\n\n示例：`{\"format\":\"parquet\",\"extfs\":{\"cloud_provider\":\"aws\",\"region\":\"us-west-2\",\"use_iam\":\"true\"}}`。"
                      }
                    },
                    "x-added-at": "3.0.x",
                    "x-last-modified": "3.0.x",
                    "x-deprecated-since": null
                  }
                },
                "required": [
                  "collectionName",
                  "snapshotName",
                  "targetS3Path"
                ],
                "x-added-at": "3.0.x",
                "x-last-modified": "3.0.x",
                "x-deprecated-since": null
              },
              "example": {
                "dbName": "default",
                "collectionName": "my_collection",
                "snapshotName": "snapshot_2026_01",
                "targetS3Path": "s3://bucket-name/export-root",
                "externalSpec": ""
              }
            }
          },
          "x-added-at": "3.0.x",
          "x-last-modified": "3.0.x",
          "x-deprecated-since": null
        },
        "responses": {
          "200": {
            "description": "Exports a collection snapshot to the configured object storage.",
            "x-i18n": {
              "zh-CN": {
                "description": "将 Collection 快照导出到已配置的对象存储。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "x-tab-label": "success",
