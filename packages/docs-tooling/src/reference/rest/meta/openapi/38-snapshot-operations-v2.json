                          ],
                          "x-added-at": "3.0.x",
                          "x-last-modified": "3.0.x",
                          "x-deprecated-since": null
                        }
                      },
                      "required": [
                        "code",
                        "data"
                      ],
                      "x-added-at": "3.0.x",
                      "x-last-modified": "3.0.x",
                      "x-deprecated-since": null
                    },
                    {
                      "x-tab-label": "failure",
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "integer",
                          "description": "Response code.",
                          "x-i18n": {
