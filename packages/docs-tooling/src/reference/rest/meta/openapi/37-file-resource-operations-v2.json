    "/v2/vectordb/file_resources/add": {
      "post": {
        "operationId": "addFileResource",
        "summary": "Add File Resource",
        "deprecated": false,
        "description": "Adds a file resource that can be referenced by Milvus features such as analyzers.",
        "x-i18n": {
          "zh-CN": {
            "summary": "添加文件资源",
            "description": "添加可供 Analyzer 等 Milvus 功能引用的文件资源。"
          }
        },
        "tags": [
          "File Resource Operations (V2)"
        ],
        "x-base-urls": {
          "$ref": "#/components/x-base-urls/ZillizVectorV2"
        },
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "description": "The authentication token should be <include target=\"zilliz\">an API key with appropriate privileges or </include>a pair of colon-joined username and password, like `username:password`.",
            "required": false,
            "example": "Bearer {{TOKEN}}",
            "schema": {
              "type": "string",
              "x-added-at": "3.0.x",
              "x-last-modified": "3.0.x",
              "x-deprecated-since": null
            },
            "x-i18n": {
              "zh-CN": {
                "description": "认证令牌，应为<include target=\"zilliz\">具备适当权限的 API 密钥或</include>用冒号分隔的用户名和密码，如 `username:password`。"
              }
            },
            "x-added-at": "3.0.x",
            "x-last-modified": "3.0.x",
            "x-deprecated-since": null
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "The unique name of the file resource.",
                    "x-i18n": {
                      "zh-CN": {
                        "description": "文件资源的唯一名称。"
                      }
                    },
                    "x-added-at": "3.0.x",
                    "x-last-modified": "3.0.x",
                    "x-deprecated-since": null
                  },
                  "path": {
                    "type": "string",
                    "description": "The object path of the file in the bucket used by Milvus persistent storage. Include the `minio.rootPath` prefix configured in the Milvus configuration file (typically `milvus.yaml`), if any. The file must already exist. For details, refer to [Manage File Resources](https://milvus.io/docs/manage-file-resources.md#Manage-File-Resources).",
                    "x-i18n": {
                      "zh-CN": {
                        "description": "文件在 Milvus 持久化存储所用 bucket 中的对象路径。如已在 Milvus 配置文件（通常为 `milvus.yaml`）中配置 `minio.rootPath`，需包含该前缀。该文件必须已存在。详情请参阅 [Manage File Resources](https://milvus.io/docs/manage-file-resources.md#Manage-File-Resources)。"
                      }
                    },
                    "x-added-at": "3.0.x",
                    "x-last-modified": "3.0.x",
                    "x-deprecated-since": null
                  }
                },
                "required": [
                  "name",
                  "path"
                ],
                "x-added-at": "3.0.x",
                "x-last-modified": "3.0.x",
                "x-deprecated-since": null
              },
              "example": {
                "name": "synonyms",
                "path": "files/synonyms.txt"
              }
            }
          },
          "x-added-at": "3.0.x",
          "x-last-modified": "3.0.x",
          "x-deprecated-since": null
        },
        "responses": {
          "200": {
            "description": "Returns an empty object.",
            "x-i18n": {
              "zh-CN": {
                "description": "返回空对象。"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/EmptyResponse",
                      "x-tab-label": "success",
                      "x-added-at": "3.0.x",
                      "x-last-modified": "3.0.x",
                      "x-deprecated-since": null
                    },
                    {
                      "$ref": "#/components/schemas/ErrorResponse",
                      "x-tab-label": "failure",
                      "x-added-at": "3.0.x",
                      "x-last-modified": "3.0.x",
                      "x-deprecated-since": null
                    }
                  ],
                  "x-added-at": "3.0.x",
                  "x-last-modified": "3.0.x",
                  "x-deprecated-since": null
                },
                "examples": {
                  "1": {
                    "summary": "success",
                    "x-target-response": "OPTION 1",
                    "value": {
                      "code": 0,
                      "data": {}
                    }
                  },
                  "2": {
                    "summary": "failure",
                    "x-target-response": "OPTION 2",
                    "value": {
                      "code": 1100,
                      "message": "file resource already exists"
                    }
                  }
                }
              }
            },
            "x-added-at": "3.0.x",
            "x-last-modified": "3.0.x",
            "x-deprecated-since": null
          }
        },
        "security": [],
        "x-added-at": "3.0.x",
        "x-last-modified": "3.0.x",
        "x-deprecated-since": null,
        "x-include-target": [
          "milvus"
        ]
      }
    },
