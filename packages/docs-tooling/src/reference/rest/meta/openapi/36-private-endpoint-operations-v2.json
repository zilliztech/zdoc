  "paths": {
    "/v2/privateEndpointServices": {
      "get": {
        "summary": "List Private Endpoint Services",
        "description": "Lists the private endpoint services available across cloud regions.",
        "tags": [
          "Private Endpoint Operations (V2)"
        ],
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "example": "Bearer {{TOKEN}}",
            "description": "The authentication token should be an API key with appropriate privileges.",
            "x-i18n": {
              "zh-CN": {
                "description": "认证令牌，应为具备适当权限的 API Key。"
              }
            },
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "projectId",
            "in": "query",
            "required": false,
            "description": "The ID of a project used to scope the available services.",
            "x-i18n": {
              "zh-CN": {
                "description": "用于限定可用服务范围的项目 ID。"
              }
            },
            "schema": {
              "type": "string"
            },
            "example": "proj-xxxxxxxxxxxxxxxxxxx"
          },
          {
            "name": "regionId",
            "in": "query",
            "required": false,
            "description": "The ID of a cloud region used to filter the services.",
            "x-i18n": {
              "zh-CN": {
                "description": "用于筛选服务的云地域 ID。"
              }
            },
            "schema": {
              "type": "string"
            },
            "examples": {
              "1": {
                "summary": "AWS",
                "x-target-lang": "en-US",
                "value": "aws-us-west-2"
              },
              "2": {
                "summary": "Alibaba Cloud",
                "x-target-lang": "zh-CN",
                "value": "ali-cn-hangzhou"
              }
            }
          },
          {
            "name": "currentPage",
            "in": "query",
            "required": false,
            "description": "The page number to return. The first page is 1.",
            "x-i18n": {
              "zh-CN": {
                "description": "返回的页码，第一页为 1。"
              }
            },
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "example": 1
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "The number of items to return per page. Values outside 1 to 100 use the default value of 10.",
